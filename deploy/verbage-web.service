[Unit]
Description=Verbage Web Frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/dialog-bot
EnvironmentFile=/opt/dialog-bot/.env
ExecStart=/opt/dialog-bot/.venv/bin/python /opt/dialog-bot/web.py
Restart=always
RestartSec=5
User=bitnami

[Install]
WantedBy=multi-user.target
